# Server
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Email transport: "smtp" (production) or "console" (development/test —
# logs the OTP to the server console only, never to API responses).
EMAIL_TRANSPORT=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="STW-Verify <your@gmail.com>"

# Master key for encrypting secrets at rest (SMTP app password).
# If unset, a key is generated at data/.secret.key (gitignored).
# Prefer setting a fixed 32-byte key in production.
MASTER_KEY=

# --- Vercel / serverless ---
# On Vercel set these env vars:
#   KV_BACKEND=redis
#   UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=<your-token>
#   STORE=redis            (use the same Upstash instance for OTPs)
#   MASTER_KEY=<fixed-key>
# Local/self-hosted leaves KV_BACKEND unset (defaults to file).

# OTP settings
OTP_TTL_MS=300000
OTP_LENGTH=4
OTP_MIN=1000
OTP_MAX=9999

# OTP storage backend: "memory" (dev/test) or "redis" (production).
# Defaults to redis automatically when REDIS_URL is set.
STORE=redis
REDIS_URL=redis://127.0.0.1:6379

# Max incorrect verification attempts before an OTP is invalidated.
VERIFY_MAX_ATTEMPTS=5

# Email delivery queue concurrency (bounds simultaneous SMTP sends).
EMAIL_QUEUE_CONCURRENCY=5

# DEV/TEST ONLY: set to true to include the OTP in the /send response so you
# can run the full send->match flow without reading the email.
# Keep false in production (never expose OTPs in API responses).
OTP_EXPOSE_IN_RESPONSE=false

# Rate limiting (milliseconds / max requests)
RATE_LIMIT_SEND_IP_WINDOW_MS=3600000
RATE_LIMIT_SEND_IP_MAX=5
RATE_LIMIT_SEND_EMAIL_WINDOW_MS=600000
RATE_LIMIT_SEND_EMAIL_MAX=3
RATE_LIMIT_MATCH_WINDOW_MS=900000
RATE_LIMIT_MATCH_MAX=10
